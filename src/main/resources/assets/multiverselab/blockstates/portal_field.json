{
  "multipart": [
    {
      "when": {
        "axis": "z",
        "gold": "false"
      },
      "apply": {
        "model": "multiverselab:block/portal_field"
      }
    },
    {
      "when": {
        "axis": "x",
        "gold": "false"
      },
      "apply": {
        "model": "multiverselab:block/portal_field",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "gold": "true"
      },
      "apply": {
        "model": "multiverselab:block/portal_field_gold"
      }
    },
    {
      "when": {
        "axis": "x",
        "gold": "true"
      },
      "apply": {
        "model": "multiverselab:block/portal_field_gold",
        "y": 90
      }
    }
  ]
}